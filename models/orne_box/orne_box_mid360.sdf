          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <distortion>
            <k1>0.130245</k1>
            <k2>-0.171765</k2>
            <k3>0.000000</k3>
            <p1>0.001621</p1>
            <p2>0.001184</p2>
            <center>0.5294 0.4695</center>
          </distortion>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <topic>image_raw</topic>
        <pose>0 0 0.8 0 -0 0</pose>
        <ignition_frame_id>zed_camera_center</ignition_frame_id>
      </sensor>

